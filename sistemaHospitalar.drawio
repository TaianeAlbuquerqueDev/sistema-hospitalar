<mxfile host="app.diagrams.net" agent="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/145.0.0.0 Safari/537.36" version="29.6.0">
  <diagram name="Página-1" id="NvezfF3ssbzEMS-eJzTX">
    <mxGraphModel dx="1037" dy="623" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="JDYs7i29iqdcPK8E8Db0-1" parent="1" style="text;whiteSpace=wrap;html=1;" value="&lt;span style=&quot;font-family: &amp;quot;Google Sans&amp;quot;, Roboto, Arial, sans-serif; font-size: 14px; background-color: rgb(255, 255, 255);&quot;&gt;&lt;font style=&quot;color: rgb(255, 51, 51);&quot;&gt;O hospital necessita de um sistema centralizado para gerenciar o atendimento clínico.&lt;/font&gt;&lt;/span&gt;&lt;div&gt;&lt;span style=&quot;color: rgb(31, 31, 31); font-family: &amp;quot;Google Sans&amp;quot;, Roboto, Arial, sans-serif; font-size: 14px; background-color: rgb(255, 255, 255);&quot;&gt;&lt;b&gt;A base do sistema reside na organização das &amp;nbsp;Especialidades médicas disponíveis (como Cardiologia ou Pediatria).&amp;nbsp;&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-family: &amp;quot;Google Sans&amp;quot;, Roboto, Arial, sans-serif; font-size: 14px; background-color: rgb(255, 255, 255);&quot;&gt;&lt;b style=&quot;&quot;&gt;&lt;font style=&quot;color: rgb(255, 102, 255);&quot;&gt;Cada Médico contratado deve obrigatoriamente pertencer a uma especialidade, estabelecendo que uma especialidade pode abrigar diversos médicos. (fk_especialidade)&lt;/font&gt;&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: rgb(31, 31, 31); font-family: &amp;quot;Google Sans&amp;quot;, Roboto, Arial, sans-serif; font-size: 14px; background-color: rgb(255, 255, 255);&quot;&gt;&lt;b&gt;Paralelamente, o hospital mantém o cadastro de seus Pacientes, registrando informações pessoais essenciais.&lt;/b&gt;&lt;/span&gt;&lt;br style=&quot;-webkit-tap-highlight-color: transparent; color: rgb(31, 31, 31); font-family: &amp;quot;Google Sans&amp;quot;, Roboto, Arial, sans-serif; font-size: 14px; background-color: rgb(255, 255, 255);&quot;&gt;&lt;span style=&quot;color: rgb(31, 31, 31); font-family: &amp;quot;Google Sans&amp;quot;, Roboto, Arial, sans-serif; font-size: 14px; background-color: rgb(255, 255, 255);&quot;&gt;&lt;b&gt;O fluxo operacional ocorre através das Consultas e Receitas.&amp;nbsp;&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-family: &amp;quot;Google Sans&amp;quot;, Roboto, Arial, sans-serif; font-size: 14px; background-color: rgb(255, 255, 255);&quot;&gt;&lt;b style=&quot;&quot;&gt;&lt;font style=&quot;color: rgb(255, 102, 255);&quot;&gt;Uma Consulta é o ponto de encontro entre o médico e o&amp;nbsp;&lt;/font&gt;&lt;/b&gt;&lt;b&gt;&lt;font style=&quot;color: rgb(255, 102, 255);&quot;&gt;paciente&amp;nbsp;&lt;/font&gt;&lt;/b&gt;&lt;b style=&quot;&quot;&gt;&lt;font style=&quot;color: rgb(255, 102, 255);&quot;&gt;em uma determinada data e hora, onde um diagnóstico é registrado. (fk_medico &amp;amp; fk_paciente)&lt;/font&gt;&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-family: &amp;quot;Google Sans&amp;quot;, Roboto, Arial, sans-serif; font-size: 14px; background-color: rgb(255, 255, 255);&quot;&gt;&lt;b style=&quot;&quot;&gt;&lt;font style=&quot;color: rgb(255, 102, 255);&quot;&gt;&amp;nbsp;Da mesma forma, uma Receita médica é emitida por um médico específico para um&amp;nbsp;&lt;/font&gt;&lt;/b&gt;&lt;b&gt;&lt;font style=&quot;color: rgb(255, 102, 255);&quot;&gt;paciente&amp;nbsp;&lt;/font&gt;&lt;/b&gt;&lt;b style=&quot;&quot;&gt;&lt;font style=&quot;color: rgb(255, 102, 255);&quot;&gt;determinado, contendo a lista de medicamentos e a data de emissão. (&lt;/font&gt;&lt;/b&gt;&lt;/span&gt;&lt;b style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); font-family: &amp;quot;Google Sans&amp;quot;, Roboto, Arial, sans-serif; font-size: 14px;&quot;&gt;&lt;font style=&quot;color: rgb(255, 102, 255);&quot;&gt;fk_medico &amp;amp;&amp;nbsp;&lt;/font&gt;&lt;/b&gt;&lt;b style=&quot;font-family: &amp;quot;Google Sans&amp;quot;, Roboto, Arial, sans-serif; font-size: 14px; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;font style=&quot;color: rgb(255, 102, 255);&quot;&gt;fk_medico)&lt;/font&gt;&lt;/b&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="190" width="626" x="134" y="10" as="geometry" />
        </mxCell>
        <mxCell id="JDYs7i29iqdcPK8E8Db0-2" parent="1" style="text;whiteSpace=wrap;html=1;" value="&lt;ul style=&quot;-webkit-tap-highlight-color: transparent; list-style: disc; margin: 1em 0px; padding: 0px 0px 0px 40px; color: rgb(31, 31, 31); font-family: &amp;quot;Google Sans&amp;quot;, Roboto, Arial, sans-serif; font-size: 14px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(255, 255, 255); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;&lt;li style=&quot;-webkit-tap-highlight-color: transparent;&quot;&gt;Especialidade: Identificador único, nome e descrição.&lt;/li&gt;&lt;li style=&quot;-webkit-tap-highlight-color: transparent;&quot;&gt;Médico: Identificador único, nome, CRM e a referência para sua especialidade (FK).&lt;/li&gt;&lt;li style=&quot;-webkit-tap-highlight-color: transparent;&quot;&gt;Paciente: Identificador único, nome, CPF e data de nascimento.&lt;/li&gt;&lt;li style=&quot;-webkit-tap-highlight-color: transparent;&quot;&gt;Consulta: Identificador único, referências para Médico e Paciente (FKs), data/hora e diagnóstico.&lt;/li&gt;&lt;li style=&quot;-webkit-tap-highlight-color: transparent;&quot;&gt;Receita: Identificador único, referências para Médico e Paciente (FKs), data de emissão e descrição dos medicamentos.&lt;/li&gt;&lt;/ul&gt;" vertex="1">
          <mxGeometry height="30" width="220" x="870" as="geometry" />
        </mxCell>
